# Frontend and backend are now served from this single Render host, so no
# separate frontend domain or CORS config is needed.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=your-app-name.onrender.com,your-custom-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app-name.onrender.com,https://your-custom-domain.com
DJANGO_DB_NAME=replace-with-render-db-name
DJANGO_DB_USER=replace-with-render-db-user
DJANGO_DB_PASSWORD=replace-with-render-db-password
DJANGO_DB_HOST=replace-with-render-internal-host
DJANGO_DB_PORT=5432
DJANGO_DB_CONN_MAX_AGE=60
DJANGO_DB_SSLMODE=require
