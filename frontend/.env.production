# The frontend is now built and served by the same Django host as the API,
# so App.jsx's same-origin defaults ("/api", window.location.origin) are
# correct. Only set these if you ever split the frontend onto its own domain
# again.
# VITE_API_BASE_URL=https://your-domain.example/api
# VITE_PUBLIC_SITE_URL=https://your-domain.example
# VITE_IMAGE_BASE_URL=https://your-domain.example
